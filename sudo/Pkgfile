# Description: Sudo (superuser do)
# URL: https://www.sudo.ws/sudo/
# Maintainer: CRUX System Team, core-ports at crux dot nu
# Arch Maintainer: CRUX-ARM System Team, devel at crux-arm dot nu
# Depends on: zlib linux-pam

name=sudo
version=1.9.17p2
release=1
source=(https://www.sudo.ws/dist/$name-$version.tar.gz
    openssl.patch
    $name.pam)

build() {
    cd $name-$version

    patch -Np1 -i $SRC/openssl.patch

    CFLAGS="$CFLAGS -flto=auto -ffat-lto-objects" \
    ./configure \
        --prefix=/usr \
        --libexecdir=/usr/lib \
        --with-logfac=auth \
        --with-vardir=/var/lib/sudo \
        --with-rundir=/run/sudo \
        --with-sendmail=/usr/sbin/sendmail \
        --disable-nls

    make
    make DESTDIR=$PKG install

    # PAM service file
    install -D -m 0644 $SRC/$name.pam $PKG/etc/pam.d/$name

    rm -r $PKG/usr/share/doc $PKG/run
}
